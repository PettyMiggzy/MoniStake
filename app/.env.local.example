# MONI site — required env vars
# Copy this file to .env.local (not tracked by git) before running locally.
# On Vercel/Netlify: set each var in the project's environment settings.

# WalletConnect project ID (get at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=89d7a1882c0fa9a5bbe0a58accafc100

# MONI token on Monad mainnet — used by the swap as the default `to` token
NEXT_PUBLIC_MONI_TOKEN=0x0CC9B2e2AcD7BACfF79eb7dB48F5662B622E7777

# Site base URL — used for OG/Twitter card image resolution
# NEXT_PUBLIC_SITE_URL=https://monistake.netlify.app

# Optional RPC / chain overrides (defaults to public Monad RPC + mainnet chain 143)
# NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
# NEXT_PUBLIC_EXPLORER_URL=https://monadscan.com
# NEXT_PUBLIC_CHAIN_ID=143
